generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model applications {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  firstName   String   @map("first_name") @db.VarChar(255)
  lastName    String?  @map("last_name") @db.VarChar(255)

  email       String   @db.VarChar(255)

  phoneNumber String   @map("phone_number") @db.VarChar(255)

  major       String?  @db.VarChar(255)

  cv          String   @db.VarChar(255)

  careerId    String   @map("career_id") @db.Uuid

  isShown     Boolean  @default(false) @map("is_shown")

  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  careers     careers  @relation( fields: [careerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model attribute_values {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  attributeValueEn     String   @map("attribute_value_en") @db.VarChar(255)
  attributeValueAr     String   @map("attribute_value_ar") @db.VarChar(255)

  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attributeId          String   @map("attribute_id") @db.Uuid

  attributes           attributes @relation( fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  variantAttributeValues variant_attribute_values[]

  @@unique([attributeId, attributeValueEn])
}

model attributes {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  attributeNameEn  String   @unique @map("attribute_name_en") @db.VarChar(255)
  attributeNameAr  String   @map("attribute_name_ar") @db.VarChar(255)

  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attributeValues  attribute_values[]
}

model banners {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  nameEn    String   @map("name_en") @db.VarChar(255)
  nameAr    String   @map("name_ar") @db.VarChar(255)

  image     String   @db.VarChar(255)

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
}

model careers {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  positionEn     String   @map("possition_en") @db.VarChar(255)
  positionAr     String   @map("possition_ar") @db.VarChar(255)

  descriptionEn  String   @map("description_en")
  descriptionAr  String   @map("description_ar")

  roleEn         String   @map("role_en") @db.VarChar(255)
  roleAr         String   @map("role_ar") @db.VarChar(255)

  experienceEn   String   @map("experience_en") @db.VarChar(255)
  experienceAr   String   @map("experience_ar") @db.VarChar(255)

  requirementsEn String[]  @map("requirements_en")
  requirementsAr String[]  @map("requirements_ar")

  slug           String   @unique @db.VarChar(255)

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  image          String   @db.VarChar(255)

  applications   applications[]
}

model cart {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId      String  @unique  @map("user_id") @db.Uuid

  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(10, 2)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  cartItems   cart_items[]
}

model cart_items {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  variantId  String   @map("variant_id") @db.Uuid
  cartId     String   @map("cart_id") @db.Uuid

  quantity   Int      @default(1)

  itemPrice  Decimal  @default(0) @map("item_price") @db.Decimal(10, 2)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cart cart  @relation(fields: [cartId],references: [id], onDelete: Cascade, onUpdate: NoAction)

  productVariants product_variants @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([cartId, variantId])
}

model categories {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  slug                  String   @unique @db.VarChar(255)

  categoryNameEn        String   @unique @map("category_name_en") @db.VarChar(255)
  categoryNameAr      String   @map("category_name_ar") @db.VarChar(255)

  categoryDescriptionEn String @map("category_description_en")
  categoryDescriptionAr String @map("category_description_ar")

  image               String   @db.VarChar(255)

  isFeatured            Boolean  @default(false) @map("is_featured")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products            products[]
}

model order_items {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  orderId     String   @map("order_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid

  productNameEn String   @map("product_name_en") @db.VarChar(255)
  productNameAr String   @map("product_name_ar") @db.VarChar(255)

  quantity    Int      @default(1)

  itemPrice   Decimal  @default(0) @map("item_price") @db.Decimal(10, 2)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders      orders   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  productVariants product_variants? @relation(fields: [variantId], references: [id], onUpdate: NoAction)
}

model orders {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId         String?  @map("user_id") @db.Uuid

  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(10, 2)

  email          String   @db.VarChar(255)
  phoneNumber    String   @map("phone_number") @db.VarChar(255)

 status           order_status  @default(PENDING)
  city           String   @db.VarChar(255)

  streetAddress  String   @map("street_address") @db.VarChar(255)

  buildingNumber Int      @map("building_number")

  additionalNote String?  @map("additional_note")

  subtotal        Decimal  @default(0) @db.Decimal(10, 2)

  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt
  orderItems     order_items[]

  users          User?   @relation(fields: [userId], references: [id], onUpdate: NoAction)

  userPromoCodes user_promo_codes[]
}

model product_variants {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sku                 String   @unique @db.VarChar(255)

  variantImage        String?  @map("variant_image") @db.VarChar(255)



  price               Decimal  @db.Decimal(10, 2)

  discountPercentage  Decimal? @default(0) @map("discount_percentage") @db.Decimal(5, 2)

  finalPrice          Decimal  @default(0) @map("final_price") @db.Decimal(10, 2)

  stock               Int      @default(0)

  productId           String   @map("product_id") @db.Uuid

  isDefault           Boolean? @default(false) @map("is_default")



  cartItems           cart_items[]
  orderItems          order_items[]

  products            products @relation(fields: [productId], references: [id],  onDelete: Cascade, onUpdate: NoAction, map: "fk_product_category")

  variantAttributeValues variant_attribute_values[]
}

model products {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  slug                  String   @unique @db.VarChar(255)

  productNameEn         String   @unique @map("product_name_en") @db.VarChar(255)
  productNameAr         String   @map("product_name_ar") @db.VarChar(255)

  productDescriptionEn  String   @map("product_description_en")
  productDescriptionAr  String   @map("product_description_ar")

  productCardImage      String   @map("product_card_image") @db.VarChar(255)

  productImages         String[] @map("product_images")

  startingPrice  Decimal  @map("starting_price") @db.Decimal(10,2)
  isFeatured            Boolean @default(false) @map("is_featured")

  categoryId            String   @map("category_id") @db.Uuid

  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  productVariants       product_variants[]

  categories            categories @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_category")

  wishlist              wishlist[]
}

model promo_codes {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code                String   @unique @db.VarChar(50)

  discountPercentage  Decimal  @map("discount_percentage") @db.Decimal(5, 2)

  maxUsage            Int      @map("max_usage")

  usedCount           Int      @default(0) @map("used_count")

  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)

  isActive            Boolean  @default(true) @map("is_active")

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  isDeleted           Boolean? @default(false) @map("is_deleted")

  userPromoCodes      user_promo_codes[]
}

model reset_password_token {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  token     String

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)

  userId    String    @map("user_id") @db.Uuid

  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_promo_codes {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId       String   @map("user_id") @db.Uuid

  promoCodeId  String   @map("promo_code_id") @db.Uuid

  orderId      String   @map("order_id") @db.Uuid

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders       orders   @relation( fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  promoCodes   promo_codes @relation(fields: [promoCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  users        User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, promoCodeId])
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

 name     String   @map("name") @db.VarChar(255)
 image     String?   @map("image") @db.VarChar(255)
  email         String   @unique @db.VarChar(255)

  password      String?  @db.VarChar(255)

  role          user_role @default(user)

  emailVerified DateTime? @map("email_verified")

  verificationToken String? @map("verification_token")

  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  // Auth.js required relations
  accounts      Account[]
  sessions      Session[]

  cart          cart[]
  orders        orders[]
  resetPasswordToken reset_password_token[]
  userPromoCodes user_promo_codes[]
  wishlist      wishlist[]
}

model Account {
  id                 String @id @default(cuid())

  userId             String @db.Uuid
  type               String
  provider           String
  providerAccountId  String

  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())

  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model variant_attribute_values {
  variantId         String @map("variant_id") @db.Uuid

  attributeValueId  String @map("attribute_value_id") @db.Uuid

  attributeValues   attribute_values @relation(fields: [attributeValueId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  productVariants   product_variants @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([variantId, attributeValueId])
}

model wishlist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  productId  String   @map("product_id") @db.Uuid

  userId     String   @map("user_id") @db.Uuid

  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  products   products @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wishlist_product")

  users      User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wishlist_user")
}

enum user_role {
  user
  admin
  super_admin
}

enum order_status {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}