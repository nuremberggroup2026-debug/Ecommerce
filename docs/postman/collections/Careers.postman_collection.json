          "raw": "{\r\n  \"positionEn\": \"Renewable Energy Engineer\",\r\n  \"positionAr\": \"مهندس طاقة متجددة\",\r\n  \"descriptionEn\": \"We are seeking a Renewable Energy Engineer to design and evaluate solar PV systems and microgrid solutions.\",\r\n  \"descriptionAr\": \"نبحث عن مهندس طاقة متجددة لتصميم وتقييم أنظمة الطاقة الشمسية والحلول الميكروشبكية.\",\r\n  \"roleEn\": \"Engineering\",\r\n  \"roleAr\": \"الهندسة\",\r\n  \"experienceEn\": \"1+ Years\",\r\n  \"experienceAr\": \"سنة أو أكثر\",\r\n  \"requirementsEn\": [\r\n    \"Bachelor degree in Electrical Engineering\",\r\n    \"Knowledge of PV systems\",\r\n    \"Experience with PVsyst\",\r\n    \"Technical reporting skills\"\r\n  ],\r\n  \"requirementsAr\": [\r\n    \"بكالوريوس هندسة كهربائية\",\r\n    \"معرفة بأنظمة الطاقة الشمسية\",\r\n    \"خبرة في PVsyst\",\r\n    \"مهارات إعداد التقارير الفنية\"\r\n  ],\r\n  \"slug\": \"renewable-energy-engineer\",\r\n  \"image\": \"https://example.com/careers/renewable-energy-engineer.jpg\"\r\n}",
